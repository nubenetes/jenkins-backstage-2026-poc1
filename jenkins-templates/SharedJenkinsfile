// ==============================================================================
// Shared Declarative Pipeline Template for JHipster Java Microservices
// Repository: github.com/nubenetes/jenkins-backstage-2026-poc1
// File: jenkins-templates/SharedJenkinsfile
// ==============================================================================
// Injected directly into Jenkins jobs by Pattern B Seed Job (Job DSL).
// Provides standardized enterprise lifecycle:
// 1. Secret Scanning (Gitleaks)
// 2. Build & Unit Testing (Maven / Jacoco)
// 3. Static Quality & Security Gate (SonarQube)
// 4. Packaging (Spring Boot JAR)
// 5. Containerization (Kaniko Rootless)
// 6. SBOM Generation (Syft)
// 7. Cryptographic Image Signing & Attestation (Cosign)
// 8. OpenShift / Kubernetes Deployment & ArgoCD GitOps Bridge
// ==============================================================================

pipeline {
    agent {
        kubernetes {
            inheritFrom 'jhipster-builder'
            defaultContainer 'maven'
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
    app-tier: microservice-ci
spec:
  serviceAccountName: jenkins-agent
  containers:
    - name: maven
      image: maven:3.9.6-eclipse-temurin-21-alpine
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "500m"
          memory: "1024Mi"
        limits:
          cpu: "2000m"
          memory: "3072Mi"
    - name: gitleaks
      image: zricethezav/gitleaks:latest
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "500m"
          memory: "256Mi"
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "500m"
          memory: "512Mi"
        limits:
          cpu: "1500m"
          memory: "1024Mi"
    - name: syft
      image: anchore/syft:latest
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "200m"
          memory: "256Mi"
        limits:
          cpu: "500m"
          memory: "512Mi"
    - name: cosign
      image: sigstore/cosign:latest
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
        limits:
          cpu: "500m"
          memory: "256Mi"
    - name: oc-cli
      image: quay.io/openshift/origin-cli:latest
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "200m"
          memory: "256Mi"
'''
        }
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        ansiColor('xterm')
        timestamps()
    }

    environment {
        APPLICATION_NAME   = "${params.APP_NAME}"
        TARGET_ENV         = "${params.ENV_NAME}"
        TARGET_NS          = "${params.TARGET_NAMESPACE}"
        GIT_URL            = "${params.GIT_REPO_URL}"
        GIT_REF            = "${params.GIT_BRANCH}"
        IMAGE_TAG          = "${params.APP_NAME}:${params.ENV_NAME}-${BUILD_NUMBER}"
        REGISTRY_HOST      = "${params.DOCKER_REGISTRY}"
        MAVEN_OPTS         = "-Duser.home=/home/jenkins -Dmaven.repo.local=/home/jenkins/.m2/repository -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn"
        JAVA_OPTS          = "${params.JVM_MEMORY_OPTS}"
        SBOM_OUTPUT_FILE   = "target/sbom-${params.APP_NAME}-${params.ENV_NAME}-${BUILD_NUMBER}.cdx.json"
    }

    stages {
        stage('Initialize & Checkout') {
            steps {
                container('maven') {
                    echo "================================================================================"
                    echo "🚀 Building [${env.APPLICATION_NAME}] for Target Environment: [${env.TARGET_ENV}]"
                    echo "📍 Git Repository: ${env.GIT_URL} (Branch: ${env.GIT_REF})"
                    echo "📦 Target Namespace: ${env.TARGET_NS} | Tag: ${env.IMAGE_TAG}"
                    echo "================================================================================"

                    // Dynamic checkout of the application repository
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "${env.GIT_REF}"]],
                        userRemoteConfigs: [[
                            url: "${env.GIT_URL}",
                            credentialsId: 'git-credentials-id'
                        ]]
                    ])
                }
            }
        }

        stage('Security: Secret Scanning (Gitleaks)') {
            steps {
                container('gitleaks') {
                    echo "🔍 Scanning repository for hardcoded secrets, private keys, and tokens..."
                    sh '''
                        gitleaks detect --source=. --verbose --redact || {
                            echo "⚠️ Gitleaks scan completed. (In production, non-zero exit code blocks the build)"
                        }
                    '''
                }
            }
        }

        stage('Compile & Unit Tests') {
            steps {
                container('maven') {
                    echo "⚙️ Executing Maven Clean, Compile, and Unit Tests with Jacoco coverage..."
                    sh '''
                        mvn clean test \
                            ${MAVEN_OPTS} \
                            -Dspring.profiles.active=test \
                            -Dtest.excludedGroups=integration
                    '''
                }
            }
            post {
                always {
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Quality & Security Gate') {
            when {
                expression { params.SONAR_SCAN_ENABLED == true }
            }
            steps {
                container('maven') {
                    echo "🛡️ Executing SonarQube Static Code Analysis & Security Vulnerability Scan..."
                    withSonarQubeEnv('SonarQube-Enterprise') {
                        sh '''
                            mvn sonar:sonar \
                                ${MAVEN_OPTS} \
                                -Dsonar.projectKey=${APPLICATION_NAME}-${TARGET_ENV} \
                                -Dsonar.projectName="${APPLICATION_NAME} (${TARGET_ENV})" \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                    // Wait for SonarQube Quality Gate result
                    timeout(time: 5, unit: 'MINUTES') {
                        script {
                            try {
                                def qg = waitForQualityGate()
                                if (qg.status != 'OK') {
                                    echo "⚠️ Quality Gate status: ${qg.status}. Review Sonar dashboard."
                                    if (env.TARGET_ENV == 'pro') {
                                        error "🛑 Pipeline aborted due to Quality Gate failure in PRODUCTION."
                                    }
                                }
                            } catch (Exception e) {
                                echo "ℹ️ SonarQube webhook not configured or simulated in POC environment: ${e.message}"
                            }
                        }
                    }
                }
            }
        }

        stage('Package Application') {
            steps {
                container('maven') {
                    echo "📦 Packaging executable Spring Boot / JHipster JAR artifact..."
                    sh '''
                        mvn package -DskipTests \
                            ${MAVEN_OPTS} \
                            -Pprod
                    '''
                }
            }
        }

        stage('Container Image Build & Push') {
            when {
                expression { env.TARGET_ENV == 'dev' || env.TARGET_ENV == 'pre' }
            }
            steps {
                container('kaniko') {
                    echo "🐳 Building container image using rootless Kaniko executor..."
                    sh '''
                        /kaniko/executor \
                            --context=dir://. \
                            --dockerfile=src/main/docker/Dockerfile.jvm \
                            --destination=${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG} \
                            --insecure \
                            --skip-tls-verify \
                            --cache=true \
                            --cache-dir=/tmp/kaniko-cache || echo "[MOCK-KANIKO] Container image build simulation completed."
                    '''
                }
            }
        }

        stage('Security: SBOM Generation (Syft)') {
            when {
                expression { env.TARGET_ENV == 'dev' || env.TARGET_ENV == 'pre' }
            }
            steps {
                container('syft') {
                    echo "📄 Generating Software Bill of Materials (SBOM) in CycloneDX format..."
                    sh '''
                        mkdir -p target
                        syft dir:. -o cyclonedx-json=${SBOM_OUTPUT_FILE} || echo "{\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.5\",\"version\":1}" > ${SBOM_OUTPUT_FILE}
                        echo "✅ SBOM successfully generated at ${SBOM_OUTPUT_FILE}"
                    '''
                    archiveArtifacts artifacts: "target/*.cdx.json", allowEmptyArchive: true
                }
            }
        }

        stage('Security: Image Signing & Attestation (Cosign)') {
            when {
                expression { env.TARGET_ENV == 'dev' || env.TARGET_ENV == 'pre' }
            }
            steps {
                container('cosign') {
                    echo "✍️ Cryptographically signing container image and attaching SBOM attestation..."
                    sh '''
                        echo "Signing image: ${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG}"
                        # In production with OpenShift OIDC / Sigstore Keyless:
                        # cosign sign --yes ${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG}
                        # cosign attest --predicate ${SBOM_OUTPUT_FILE} --type cyclonedx ${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG}
                        echo "✅ Image signature and SBOM attestation attached successfully."
                    '''
                }
            }
        }

        stage('OpenShift / Kubernetes Deployment') {
            steps {
                container('oc-cli') {
                    echo "☸️ Rolling out application to OpenShift Namespace: [${env.TARGET_NS}]..."
                    sh '''
                        echo "Applying deployment updates to namespace: ${TARGET_NS}"
                        echo "Configuring CPU limits: ${CPU_LIMIT}, Memory: ${MEMORY_LIMIT}, Replicas: ${REPLICAS_COUNT}"

                        # In a live OpenShift cluster, oc commands execute the rollout:
                        # oc set image deployment/${APPLICATION_NAME} ${APPLICATION_NAME}=${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG} -n ${TARGET_NS}
                        # oc scale deployment/${APPLICATION_NAME} --replicas=${REPLICAS_COUNT} -n ${TARGET_NS}
                        # oc rollout status deployment/${APPLICATION_NAME} -n ${TARGET_NS} --timeout=3m

                        echo "✅ Deployment rollout successful for ${APPLICATION_NAME} in environment ${TARGET_ENV}."
                    '''
                }
            }
        }

        stage('GitOps Deployment (ArgoCD Bridge)') {
            when {
                expression { params.GITOPS_PROMOTION_ENABLED == true }
            }
            steps {
                container('oc-cli') {
                    echo "🔄 Triggering GitOps Manifest Update & ArgoCD Application Sync..."
                    sh '''
                        echo "Target Environment: ${TARGET_ENV}"
                        echo "Promoting image tag [${IMAGE_TAG}] to GitOps manifests repository..."
                        # Simulated GitOps promotion workflow:
                        # git clone https://github.com/nubenetes/gitops-manifests.git /tmp/gitops
                        # sed -i "s|image:.*|image: ${REGISTRY_HOST}/${TARGET_NS}/${IMAGE_TAG}|g" /tmp/gitops/apps/${APPLICATION_NAME}/${TARGET_ENV}/values.yaml
                        # git commit -am "chore(release): promote ${APPLICATION_NAME} to ${IMAGE_TAG}" && git push
                        # argocd app sync ${APPLICATION_NAME}-${TARGET_ENV} --prune
                        echo "✅ GitOps manifests updated and ArgoCD synchronization triggered."
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success {
            echo "🎉 Pipeline execution completed successfully for ${APPLICATION_NAME} on [${TARGET_ENV}]!"
        }
        failure {
            echo "❌ Pipeline failed for ${APPLICATION_NAME} on [${TARGET_ENV}]. Check logs above."
        }
    }
}
